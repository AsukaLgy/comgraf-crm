# Generar secretos únicos: python scripts/configure.py
MYSQL_DATABASE=comgraf
MYSQL_USER=comgraf
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
DB_HOST=db
DB_PORT=3306
APP_TIMEZONE=America/Tegucigalpa
PRODUCT_VERSION=1.4.0
BUILD_ID=local-1.4.0
COOKIE_SECURE=true
# HTTPS protege toda la interfaz. Para LAN usa la misma IP en HTTPS_HOST y HTTPS_BIND.
HTTPS_HOST=localhost
HTTPS_BIND=127.0.0.1
HTTPS_PORT=443
# Este puerto HTTP solo redirige al HTTPS principal.
HTTP_BIND=127.0.0.1
HTTP_REDIRECT_PORT=8080
UPLOAD_DIR=/data/uploads
STATIC_DIR=/app/frontend/dist
